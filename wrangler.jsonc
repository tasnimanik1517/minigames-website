// Cloudflare Workers (static assets) config for minigames.website.
// Workers Builds runs the Build command (npm run build -> dist/), then deploys dist/ with
// `npx wrangler deploy` (main) or `npx wrangler preview` (other branches).
{
  "name": "minigames-website",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
